    local notifHolder = new("Frame", {
        AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16), Size = UDim2.fromOffset(260, 400),
        BackgroundTransparency = 1, ZIndex = 10, Parent = gui,
    })
    new("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Right, Parent = notifHolder})
    local notifCount = 0

    -- Window:Notify("Title", "Text", 3)  or  Window:Notify({Title = "", Content = "", Duration = 3})
    function Window:Notify(head, text, dur)
        if destroyed then return end
        if type(head) == "table" then head, text, dur = head.Title, head.Content or head.Text, head.Duration end
        dur = dur or 3
        notifCount = notifCount + 1

        local slot = new("Frame", {Size = UDim2.fromOffset(260, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = notifCount, Parent = notifHolder})
        -- starts just off the right edge, slides in to the left, then slides back out to the right
        local OFF = 300
        local n = new("Frame", {
            Position = UDim2.fromOffset(OFF, 0), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = Theme.Background, BorderSizePixel = 0, Parent = slot,
        })
        corner(n, 4)
        stroke(n)
        local body = new("Frame", {Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = n})
        new("UIListLayout", {Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = body})
        pad(body, 0, 8, 0, 10)
        local h = label(body, tostring(head or ""), 13, Theme.Text, Fonts.Bold)
        h.Size = UDim2.new(1, 0, 0, 16)
        h.LayoutOrder = 1
        if text and text ~= "" then
            local t = label(body, tostring(text), 12, Theme.SubText, Fonts.Regular)
            t.Size = UDim2.new(1, 0, 0, 14)
            t.AutomaticSize = Enum.AutomaticSize.Y
            t.TextWrapped = true
            t.TextTruncate = Enum.TextTruncate.None
            t.LayoutOrder = 2
        end

        tw(n, 0.4, {Position = UDim2.fromOffset(0, 0)})
        task.delay(dur, function()
            if destroyed or not slot.Parent then return end
            tw(n, 0.35, {Position = UDim2.fromOffset(OFF, 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            task.wait(0.35)
            if destroyed or not slot.Parent then return end
            -- close the gap so the notifications above glide down instead of jumping
            slot.AutomaticSize = Enum.AutomaticSize.None
            slot.Size = UDim2.fromOffset(260, n.AbsoluteSize.Y)
            n.Visible = false
            tw(slot, 0.2, {Size = UDim2.fromOffset(260, 0)}).Completed:Wait()
            slot:Destroy()
        end)
    end

