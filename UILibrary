    Window.PerformanceStats = {}
    for i, d in ipairs(perfDefs) do
        local sep = new("Frame", {Size = UDim2.fromOffset(1, 12), BackgroundColor3 = Theme.Stroke, BorderSizePixel = 0, LayoutOrder = i * 2 - 1, Parent = perfFrame})
