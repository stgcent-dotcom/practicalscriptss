                end
                local chip, api = makeChip(f, bind, opt.Changed)
                chip.Position = UDim2.new(1, -10, 0.5, 0)
                return register(opt, {Set = function(_, k) api:Set(k) end, Get = function() return bind.Key end}, "Keybind")
            end

            function Sub:Textbox(opt)
                local f = base(32)
                local l = label(f, opt.Name or "Textbox", 13)
                l.Position = UDim2.fromOffset(12, 0)
                l.Size = UDim2.new(1, -150, 1, 0)
                local box = new("TextBox", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(130, 22),
                    BackgroundColor3 = Theme.Background, BorderSizePixel = 0, Text = opt.Default or "",
                    PlaceholderText = opt.Placeholder or "...", PlaceholderColor3 = Theme.SubText,
                    TextColor3 = Theme.Text, Font = Fonts.Regular, TextSize = 12, ClearTextOnFocus = false,
                    ClipsDescendants = true, TextTruncate = Enum.TextTruncate.AtEnd, Parent = f,
                })
                corner(box, 3)
                pad(box, 6, 0, 6, 0)
                local s = stroke(box)
                box.Focused:Connect(function() tw(s, 0.15, {Color = accent}) end)
                box.FocusLost:Connect(function(enter)
                    tw(s, 0.15, {Color = Theme.Stroke})
                    if opt.Numeric and not tonumber(box.Text) then box.Text = "" end
                    if opt.Callback then task.spawn(opt.Callback, box.Text, enter) end
                end)

                local obj = {}
                function obj:Set(t, silent)
                    box.Text = tostring(t or "")
                    if not silent and opt.Callback then task.spawn(opt.Callback, box.Text, false) end
                end
                function obj:Get() return box.Text end
                return register(opt, obj, "Textbox")
            end

            return Sub
        end

        return Tab
    end

