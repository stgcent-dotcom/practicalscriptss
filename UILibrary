    -----------------------------------------------------------------
    -- theming
    -----------------------------------------------------------------
    local ThemeKeys = {"Accent", "Background", "Sidebar", "Element", "Hover", "Stroke", "Text", "SubText"}
    local function C(r, g, b) return Color3.fromRGB(r, g, b) end
    local Presets = {
        Default = {Accent = C(124, 92, 255), Background = C(17, 17, 21), Sidebar = C(13, 13, 17), Element = C(27, 27, 33), Hover = C(35, 35, 43), Stroke = C(44, 44, 54), Text = C(236, 236, 242), SubText = C(140, 140, 156)},
        Ocean   = {Accent = C(56, 189, 248), Background = C(12, 18, 26), Sidebar = C(9, 14, 21), Element = C(20, 29, 40), Hover = C(28, 40, 54), Stroke = C(36, 52, 70), Text = C(232, 240, 248), SubText = C(125, 145, 165)},
        Rose    = {Accent = C(244, 114, 182), Background = C(20, 14, 18), Sidebar = C(15, 10, 14), Element = C(31, 22, 27), Hover = C(40, 29, 35), Stroke = C(58, 42, 50), Text = C(246, 236, 241), SubText = C(160, 135, 148)},
        Mint    = {Accent = C(52, 211, 153), Background = C(13, 19, 17), Sidebar = C(10, 15, 13), Element = C(22, 31, 28), Hover = C(30, 41, 37), Stroke = C(43, 58, 52), Text = C(234, 246, 241), SubText = C(130, 155, 145)},
        Mono    = {Accent = C(205, 209, 220), Background = C(16, 16, 18), Sidebar = C(12, 12, 14), Element = C(26, 26, 29), Hover = C(34, 34, 38), Stroke = C(46, 46, 52), Text = C(240, 240, 244), SubText = C(135, 135, 146)},
    }
    local function near(a, b)
        return math.abs(a.R - b.R) < 0.004 and math.abs(a.G - b.G) < 0.004 and math.abs(a.B - b.B) < 0.004
    end

    -- Applies any subset of theme colors in one pass (matches against the old values).
    local function applyTheme(new_)
        local old = {}
        for _, k in ipairs(ThemeKeys) do old[k] = Theme[k] end
        for _, k in ipairs(ThemeKeys) do
            if new_[k] then Theme[k] = new_[k] end
        end
        accent = Theme.Accent
        local function remap(c)
            for _, k in ipairs(ThemeKeys) do
                if new_[k] and near(c, old[k]) then return new_[k] end
            end
            return nil
        end
        for _, d in ipairs(gui:GetDescendants()) do
            if d:IsA("GuiObject") then
                if not d:GetAttribute("NoTheme") then
                    local n = remap(d.BackgroundColor3)
                    if n then d.BackgroundColor3 = n end
                end
                if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                    local n = remap(d.TextColor3)
                    if n then d.TextColor3 = n end
                end
                if d:IsA("TextBox") then
                    local n = remap(d.PlaceholderColor3)
                    if n then d.PlaceholderColor3 = n end
                end
                if d:IsA("ScrollingFrame") then
                    local n = remap(d.ScrollBarImageColor3)
                    if n then d.ScrollBarImageColor3 = n end
                end
            elseif d:IsA("UIStroke") then
                local n = remap(d.Color)
                if n then d.Color = n end
            end
        end
    end
    function Window:SetTheme(t) applyTheme(t) end
    function Window:GetTheme()
        local t = {}
        for _, k in ipairs(ThemeKeys) do t[k] = Theme[k] end
        return t
    end
    function Window:SetRoundness(f)
        roundFactor = f
        for _, d in ipairs(gui:GetDescendants()) do
            if d:IsA("UICorner") then
                local b = d:GetAttribute("Round")
                if b then d.CornerRadius = UDim.new(0, math.floor(b * f + 0.5)) end
            end
        end
    end
    function Window:SetOpacity(p)
        baseTrans = 1 - p
        if menuOpen and ready then
            animId = animId + 1
            if baseTrans > 0 then
                setGrouped(true)
                fader.GroupTransparency = baseTrans
            else
                fader.GroupTransparency = 0
                setGrouped(false)
            end
        end
    end

    -- Adds a ready-made "Theme" subtab (presets, color pickers, roundness, opacity) to a tab.
    function Window:AddThemeSubTab(tab, name)
        local sub = tab:SubTab(name or "Theme")
        local pickers = {}
        local presetDrop, roundSlider, opacitySlider

        sub:Section("Presets")
        presetDrop = sub:Dropdown({Name = "Preset", Options = {"Default", "Ocean", "Rose", "Mint", "Mono"}, Default = "Default", Callback = function(n)
            applyTheme(Presets[n])
            for _, k in ipairs(ThemeKeys) do pickers[k]:Set(Theme[k], true) end
        end})

        sub:Section("Colors", {MaxHeight = 230})
        local names = {Accent = "Accent", Background = "Background", Sidebar = "Sidebar", Element = "Elements", Hover = "Hover", Stroke = "Borders", Text = "Text", SubText = "Muted Text"}
        for _, k in ipairs(ThemeKeys) do
            local key = k
            pickers[key] = sub:ColorPicker({Name = names[key], Default = Theme[key], Flag = "Theme." .. key, Callback = function(c) applyTheme({[key] = c}) end})
        end

        sub:Section("Interface")
        roundSlider = sub:Slider({Name = "Corner Roundness", Min = 0, Max = 10, Default = 4, Increment = 1, Flag = "Theme.Roundness", Callback = function(v) Window:SetRoundness(v / 4) end})
        opacitySlider = sub:Slider({Name = "Window Opacity", Min = 40, Max = 100, Default = 100, Increment = 1, Suffix = "%", Flag = "Theme.Opacity", Callback = function(v) Window:SetOpacity(v / 100) end})

        sub:Section("Actions")
        sub:Button({Name = "Reset Theme", Callback = function()
            presetDrop:Set("Default")
            roundSlider:Set(4)
            opacitySlider:Set(100)
        end})
        return sub
    end

    -----------------------------------------------------------------
    -- configs (executor file access: writefile/readfile/isfile/isfolder/makefolder)
    -----------------------------------------------------------------
    local hasFS = (writefile and readfile and isfile and isfolder and makefolder) and true or false
    local cfgDir = folder .. "/configs"

    local function cleanName(n)
        local s = string.gsub(tostring(n or ""), "[^%w%s%-_]", "")
        return string.match(s, "^%s*(.-)%s*$") or ""
    end
    local function ensureDirs()
        if not isfolder(folder) then makefolder(folder) end
        if not isfolder(cfgDir) then makefolder(cfgDir) end
    end
    local function cfgPath(n) return cfgDir .. "/" .. n .. ".json" end

    function Window:SaveConfig(name)
        if not hasFS then return false, "File access isn't available." end
        name = cleanName(name)
        if name == "" then return false, "Enter a config name first." end
        local data = {}
        for flag, obj in pairs(Window.Flags) do data[flag] = encode(obj:Get()) end
        local ok, err = pcall(function()
            ensureDirs()
            writefile(cfgPath(name), HttpService:JSONEncode(data))
        end)
        if not ok then return false, tostring(err) end
        return true, name
    end

    function Window:LoadConfig(name)
        if not hasFS then return false, "File access isn't available." end
        name = cleanName(name)
        if name == "" or not isfile(cfgPath(name)) then return false, "Config not found." end
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(cfgPath(name))) end)
        if not ok or type(data) ~= "table" then return false, "Config file is corrupted." end
        for flag, raw in pairs(data) do
            local obj = Window.Flags[flag]
            if obj then pcall(obj.Set, obj, decode(raw)) end
        end
        return true, name
    end

    function Window:DeleteConfig(name)
        name = cleanName(name)
        if not hasFS or not delfile or name == "" or not isfile(cfgPath(name)) then return false end
        local ok = pcall(delfile, cfgPath(name))
        return ok
    end

    function Window:ListConfigs()
        local out = {}
        if not hasFS or not listfiles then return out end
        pcall(function()
            ensureDirs()
            for _, p in ipairs(listfiles(cfgDir)) do
                local n = string.match(p, "([^/\\]+)%.json$")
                if n then table.insert(out, n) end
            end
        end)
        table.sort(out)
        return out
    end

    function Window:SetAutoload(name)
        if not hasFS then return false end
        local ok = pcall(function()
            ensureDirs()
            writefile(folder .. "/autoload.txt", cleanName(name))
        end)
        return ok
    end
    local function getAutoload()
        if not hasFS then return nil end
        local ok, n = pcall(function()
            local p = folder .. "/autoload.txt"
            if isfile(p) then return readfile(p) end
            return nil
        end)
        n = ok and cleanName(n) or ""
        if n == "" then return nil end
        return n
    end

    -- Adds a ready-made "Configs" subtab (save, load, delete, autoload) to a tab.
    function Window:AddConfigSubTab(tab, name)
        local sub = tab:SubTab(name or "Configs")
        if not hasFS then
            sub:Section("Configs")
            sub:Label("Your executor doesn't support file access, so configs can't be saved.")
            return sub
        end

        sub:Section("Create")
        local nameBox = sub:Textbox({Name = "Config Name", Placeholder = "my config"})
        local listDrop
        sub:Button({Name = "Save Config", Callback = function()
            local ok, res = Window:SaveConfig(nameBox:Get())
            Window:Notify("Configs", ok and ("Saved \"" .. res .. "\".") or res, 3)
            if ok then
                listDrop:Refresh(Window:ListConfigs())
                listDrop:Set(res, true)
            end
        end})

        sub:Section("Saved")
        listDrop = sub:Dropdown({Name = "Config", Options = Window:ListConfigs()})
        local autoLabel = sub:Label("Autoload: " .. (getAutoload() or "none"))
        sub:Button({Name = "Load Config", Callback = function()
            local ok, res = Window:LoadConfig(listDrop:Get())
            Window:Notify("Configs", ok and ("Loaded \"" .. res .. "\".") or res, 3)
        end})
        sub:Button({Name = "Overwrite Config", Callback = function()
            local n = listDrop:Get()
            if not n then Window:Notify("Configs", "Pick a config first.", 3) return end
            local ok, res = Window:SaveConfig(n)
            Window:Notify("Configs", ok and ("Overwrote \"" .. res .. "\".") or res, 3)
        end})
        sub:Button({Name = "Delete Config", Callback = function()
            local n = listDrop:Get()
            if n and Window:DeleteConfig(n) then
                Window:Notify("Configs", "Deleted \"" .. n .. "\".", 3)
                listDrop:Refresh(Window:ListConfigs())
            else
                Window:Notify("Configs", "Couldn't delete that config.", 3)
            end
        end})
        sub:Button({Name = "Set as Autoload", Callback = function()
            local n = listDrop:Get()
            if not n then Window:Notify("Configs", "Pick a config first.", 3) return end
            Window:SetAutoload(n)
            autoLabel:Set("Autoload: " .. n)
            Window:Notify("Configs", "\"" .. n .. "\" will load on startup.", 3)
        end})
        sub:Button({Name = "Clear Autoload", Callback = function()
            Window:SetAutoload("")
            autoLabel:Set("Autoload: none")
        end})
        sub:Button({Name = "Refresh List", Callback = function() listDrop:Refresh(Window:ListConfigs()) end})
        return sub
    end

    -----------------------------------------------------------------
    -- touch toggle button (phones/tablets have no keyboard)
    -----------------------------------------------------------------
    local touchBtn
    if UIS.TouchEnabled then
        -- the tap target keeps a dark square so the P stays visible over bright games
        touchBtn = new("Frame", {Position = UDim2.new(0, 16, 0.5, -22), Size = UDim2.fromOffset(44, 44), BackgroundColor3 = Theme.Background, BorderSizePixel = 0, Visible = false, Parent = gui})
        corner(touchBtn, 6)
        stroke(touchBtn)
        local tp = makeLogo(touchBtn, UDim2.fromScale(0.5, 0.5), 28, string.sub(title, 1, 1))
        tp.AnchorPoint = Vector2.new(0.5, 0.5)
        tp.TextYAlignment = Enum.TextYAlignment.Center
        -- transparent hit area on top of the logo so the label doesn't swallow touches
        local hit = new("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 5, Parent = touchBtn})
        hit.InputBegan:Connect(function(i)
            if not isPress(i) then return end
            local startInput, startPos, moved = i.Position, touchBtn.Position, false
            beginDrag(function(m)
                local d = m.Position - startInput
                if d.Magnitude > 6 then moved = true end
                if moved then
                    touchBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
                end
            end, function()
                if not moved then toggleMenu() end
            end)
        end)
    end

    function Window:Destroy()
        if destroyed then return end
        destroyed = true
        for _, c in ipairs(allConns) do pcall(function() c:Disconnect() end) end
        table.clear(allConns)
        perfConn = nil
        gui:Destroy()
        if env.__PracticalScriptsUI == Window.__cleanup then env.__PracticalScriptsUI = nil end
    end
    Window.__cleanup = function() Window:Destroy() end
    env.__PracticalScriptsUI = Window.__cleanup

    -----------------------------------------------------------------
    -- startup animation
    -----------------------------------------------------------------
    local splash = new("CanvasGroup", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(340, 116), BackgroundColor3 = Theme.Background, BorderSizePixel = 0,
        GroupTransparency = 1, Parent = gui,
    })
    corner(splash, 5)
    stroke(splash)
    local splashScale = new("UIScale", {Parent = splash})

    -- shrink the window on small screens so it always fits
    local function rescale()
        local vp = gui.AbsoluteSize
        if vp.X <= 0 or vp.Y <= 0 then return end
        mainScale.Scale = math.clamp(math.min((vp.X - 24) / WIN_W, (vp.Y - 24) / WIN_H), 0.5, 1)
        if splashScale.Parent then splashScale.Scale = math.clamp((vp.X - 24) / 340, 0.5, 1) end
    end
    rescale()
    connect(gui:GetPropertyChangedSignal("AbsoluteSize"), rescale)

    local splashFirst = string.sub(title, 1, 1)
    makeLogo(splash, UDim2.fromOffset(24, 14), 36, splashFirst)
    local sx = 24 + letterWidth(splashFirst, 36) + 1
    local sTitle = label(splash, string.sub(title, 2), 24, Theme.Text, Fonts.Bold)
    sTitle.TextYAlignment = Enum.TextYAlignment.Bottom
    sTitle.Position = UDim2.fromOffset(sx, 14)
    sTitle.Size = UDim2.new(1, -(sx + 12), 0, 33)
    local sSub = label(splash, cfg.Subtitle or "Loading...", 12, Theme.SubText, Fonts.Regular)
    if not cfg.Subtitle then
        -- game name needs a web request, so fetch it in the background and swap the text in
        task.spawn(function()
            local ok, info = pcall(function()
                return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
            end)
            local name = ok and type(info) == "table" and info.Name or nil
            if (not name or name == "") and game.Name ~= "" and game.Name ~= "Game" then name = game.Name end
            if name and sSub.Parent and not string.find(sSub.Text, "^Loaded") then
                sSub.Text = "Loading for " .. name
            end
        end)
    end
    sSub.Position = UDim2.fromOffset(24, 62)
    sSub.Size = UDim2.new(1, -48, 0, 16)
    local barBg = new("Frame", {Position = UDim2.fromOffset(24, 88), Size = UDim2.new(1, -48, 0, 4), BackgroundColor3 = Theme.Element, BorderSizePixel = 0, Parent = splash})
    corner(barBg, 2)
    local barFill = new("Frame", {Size = UDim2.fromScale(0, 1), BackgroundColor3 = accent, BorderSizePixel = 0, Parent = barBg})
    corner(barFill, 2)

    task.spawn(function()
        tw(splash, 0.35, {GroupTransparency = 0}, Enum.EasingStyle.Sine)
        task.wait(0.35)
        tw(barFill, 1.2, {Size = UDim2.fromScale(1, 1)}, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
        task.wait(1.25)
        if destroyed then return end
        sSub.Text = string.format("Loaded in %.1fs", os.clock() - startClock)
        task.wait(0.6)
        tw(splash, 0.3, {GroupTransparency = 1}, Enum.EasingStyle.Sine)
        task.wait(0.3)
        if destroyed then return end
        splash:Destroy()

        showMain(0.4)
        task.wait(0.45)
        if destroyed then return end
        ready = true
        if touchBtn then touchBtn.Visible = true end

        local auto = getAutoload()
        if auto then
            local ok = Window:LoadConfig(auto)
            if ok then Window:Notify("Configs", "Autoloaded \"" .. auto .. "\".", 3) end
        end
        local hint
        if touchBtn then
            hint = "Tap the P button to hide or show the menu."
        else
            hint = "Press " .. keyName(menuBind.Key) .. " to hide or show the menu."
        end
        Window:Notify(title, hint, 4)
    end)

    -----------------------------------------------------------------
    -- built-in Settings tab (always listed last). Settings = false skips it.
    -----------------------------------------------------------------
    if cfg.Settings ~= false then
        local settingsTab = Window:Tab("Settings", true)
        local ui = settingsTab:SubTab("Interface")
        ui:Section("Menu")
        ui:Keybind({Name = "Menu Key", Default = menuBind.Key, Menu = true, Flag = "UI.MenuKey"})
        ui:Toggle({Name = "Auto-hide Sidebar", Default = autoHide, Flag = "UI.AutoHideSidebar", Callback = function(v) Window:SetSidebarAutoHide(v) end})
        ui:Button({Name = "Unload UI", Callback = function() Window:Destroy() end})
        Window:AddPrivacySettings(ui)
        Window:AddOverlaySettings(ui)
        Window:AddThemeSubTab(settingsTab)
        Window:AddConfigSubTab(settingsTab)
        Window.SettingsTab = settingsTab
    end

    return Window
end

return Library
