    local function layoutPerf()
        local first = true
        for _, k in ipairs(perfOrder) do
            local it = perfItems[k]
            it.Item.Visible = it.On
            it.Sep.Visible = it.On and not first
            if it.On then first = false end
        end
    end
    layoutPerf()

    local pingStat
    pcall(function() pingStat = Stats.Network.ServerStatsItem["Data Ping"] end)
    local function getPing()
        if pingStat then
            local ok, v = pcall(function() return pingStat:GetValue() end)
            if ok and v then return v end
        end
        local ok, v = pcall(function() return lp:GetNetworkPing() * 2000 end)
        if ok and v then return v end
        return 0
    end

    local perfConn, perfAcc, perfFrames = nil, 0, 0
    local function perfRefresh()
        local fps = perfFrames / perfAcc
        local items = perfItems
        if items.FPS.On then items.FPS.Value.Text = tostring(math.floor(fps + 0.5)) end
        if items.FrameTime.On then items.FrameTime.Value.Text = string.format("%.1f", perfAcc / perfFrames * 1000) end
        if items.Ping.On then items.Ping.Value.Text = tostring(math.floor(getPing() + 0.5)) .. " ms" end
        if items.Memory.On then
            local ok, mb = pcall(function() return Stats:GetTotalMemoryUsageMb() end)
            items.Memory.Value.Text = ok and (tostring(math.floor(mb + 0.5)) .. " MB") or "-"
        end
        if items.Players.On then items.Players.Value.Text = tostring(#Players:GetPlayers()) .. "/" .. tostring(Players.MaxPlayers) end
        if items.Session.On then
            local s = math.floor(workspace.DistributedGameTime)
            local hrs = math.floor(s / 3600)
            local mins = math.floor((s % 3600) / 60)
            if hrs > 0 then
                items.Session.Value.Text = string.format("%d:%02d:%02d", hrs, mins, s % 60)
            else
                items.Session.Value.Text = string.format("%d:%02d", mins, s % 60)
            end
        end
    end

    function Window:SetPerformanceVisible(v)
        v = v == true
        perfFrame.Visible = v
        if v and not perfConn then
            perfAcc, perfFrames = 0, 0
            perfConn = connect(RunService.RenderStepped, function(dt)
                perfAcc = perfAcc + dt
                perfFrames = perfFrames + 1
                if perfAcc >= 0.5 then
                    perfRefresh()
                    perfAcc, perfFrames = 0, 0
                end
            end)
        elseif not v and perfConn then
            perfConn:Disconnect()
            perfConn = nil
        end
    end
    -- on by default; pass PerformanceStats = false to CreateWindow to start hidden
    Window:SetPerformanceVisible(cfg.PerformanceStats ~= false)

    function Window:SetPerformanceStat(key, v)
        local it = perfItems[key]
        if not it then return end
        it.On = v == true
        layoutPerf()
    end
