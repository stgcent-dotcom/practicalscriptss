    -- Key, label text, min value width, shown by default
    local perfDefs = {
        {"FPS", "FPS", 24, true},
        {"FrameTime", "MS", 28, true},
        {"Ping", "Ping", 40, true},
        {"Memory", "Mem", 50, true},
        {"Players", "Players", 30, false},
